PROJECT_NAME=rm_workflow_store

# --- App ---
APP_PORT=8002
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-not-for-production
DJANGO_ALLOWED_HOSTS=*

# --- Database ---
# IMPORTANT: must be a DIFFERENT database than rm_auth_project's and
# rm_auth_tenant's own .env files -- three separate Django projects/
# migration histories. Pointing more than one at the same physical database
# produces InconsistentMigrationHistory errors (see the "Tier B
# Implementation Plan" doc's correction note for the incident this caused
# for rm_auth/rm_auth_tenant originally).
POSTGRES_DB=rm_workflow_appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppassword
POSTGRES_PORT=5432
POSTGRES_HOST=db
